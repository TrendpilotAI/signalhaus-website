# Signalhaus - environment variables
# Copy this file to .env.local for local development.
# On Vercel, set these under Settings -> Environment Variables.
#
# The site builds and runs with no variables set. The lead forms do not: they
# answer every submission with an error until a record sink below (Resend or
# Lightfield) is switched on and configured. That is on purpose, and it is the
# same locally, on Preview and in Production.

# --- Lead pipeline ----------------------------------------------------------
# The forms post to /api/leads. Feature flags must be exactly the string "true"
# (lower case). Anything else, including "TRUE" or "1", is off.
#
# The pipeline fails closed:
# - The form reports success only when a record sink took the lead. The record
#   sinks are the Resend email, the Proton copy and Lightfield.
# - Slack only notifies. A Slack message on its own does not count.
# - Every submission also leaves one line in the server log, with a masked
#   email (j***@acme.com), the topic, the source form and the post slug. That
#   line does not keep the lead and never counts.
# - A sink whose flag is "true" but whose other variables are missing counts as
#   failed, and the log names the missing variables.
# When no record sink takes the lead, the visitor is asked to try again in a
# minute and keeps what they typed.

# Email notification through Resend. A record sink.
# Off unless LEAD_RESEND_ENABLED is exactly "true". Having the API key alone
# sends nothing. Once the flag is "true" it needs RESEND_API_KEY and a recipient
# in LEAD_NOTIFY_TO. With either missing, every submission fails.
LEAD_RESEND_ENABLED=false
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where lead notifications are delivered. If this is empty, the older
# CONTACT_EMAIL variable is used when it is set.
LEAD_NOTIFY_TO=
# Optional. The From address. It must be on the verified sending domain
# send.signalhaus.ai. Never use an @signalhaus.ai address here, because the root
# domain's DMARC policy uses strict DKIM alignment. An address on any other
# domain is ignored and the default below is used instead.
LEAD_NOTIFY_FROM="Signalhaus leads <leads@send.signalhaus.ai>"

# Proton inbox copy. Optional second recipient for each lead. A record sink.
# Proton has no inbound API, so this copy is sent through Resend and needs
# LEAD_RESEND_ENABLED=true and RESEND_API_KEY as well. Leave it empty for one
# email per lead. It is skipped when it is the same address as LEAD_NOTIFY_TO.
LEAD_PROTON_INBOX=

# Lightfield CRM. A record sink.
# A lead whose email is not in Lightfield becomes a new contact in one holding
# account, with an opportunity named
# "Signalhaus · <topic> · <company, or the person's name>" and the lead as a
# note. The form never makes an account for the company a visitor typed in.
# A lead whose email matches a contact who is already in Lightfield is filed
# under that contact and marked "(email not verified)" in the opportunity name
# and the note, because the form does not check who owns an address. The
# existing contact is never written to. If that contact sits in an account of
# their own with an open "Signalhaus · " opportunity, the note goes on that one
# and no second opportunity is made. Nothing is reused in the holding account.
# Off unless LEAD_LIGHTFIELD_ENABLED is exactly "true". Once the flag is "true"
# it needs LIGHTFIELD_API_KEY and LIGHTFIELD_STAGE_LEAD. With either missing it
# counts as failed and never calls Lightfield.
# The key needs these scopes: accounts:read, accounts:create, contacts:read,
# contacts:create, opportunities:read, opportunities:create, notes:create.
LEAD_LIGHTFIELD_ENABLED=false
LIGHTFIELD_API_KEY=
# Optional. The name of the holding account that new contacts go into. Leave
# empty for the default, "Signalhaus web leads". The account is found by its
# exact name and is made the first time a lead needs it.
LIGHTFIELD_HOLDING_ACCOUNT=
# Required when the flag is "true". The stage a new opportunity starts in. Use
# the option ID (opt_...) of the "Lead" stage in the Signalhaus pipeline. An ID
# picks the stage and its pipeline together. A label ("Lead", exact case) also
# works, but on its own Lightfield looks it up in the default pipeline, so pair
# a label with LIGHTFIELD_PIPELINE_OPTION.
LIGHTFIELD_STAGE_LEAD=
# Optional. The pipeline a new opportunity goes in: the pipeline ID (pd_...) or
# its name. Only needed when LIGHTFIELD_STAGE_LEAD is a label.
LIGHTFIELD_PIPELINE_OPTION=
# Optional. The key of an opportunity field to write the description to
# (source, page, post slug, topic, UTM values and the visitor's message).
# Opportunities have no description field until one is added in Lightfield,
# so leave this empty until then. The note always carries the same details.
LIGHTFIELD_OPPORTUNITY_DESCRIPTION_FIELD=
# Optional. Set to "true" to let Lightfield enrich new contacts. Enrichment is metered.
LEAD_LIGHTFIELD_ENRICH=false
# Optional overrides. Leave empty to use the defaults.
LIGHTFIELD_API_BASE_URL=
LIGHTFIELD_API_VERSION=

# Slack notification through an incoming webhook. Notify-only: a Slack message
# never makes a submission count, so switch on a record sink as well.
# Off unless LEAD_SLACK_ENABLED is exactly "true". Once it is, it needs SLACK_WEBHOOK_URL.
LEAD_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Rate limiting (Upstash Redis) ------------------------------------------
# The lead route allows 5 submissions per IP every 15 minutes.
# With these set, the count is shared across serverless instances.
# Without them, the app falls back to an in-memory limiter that is fine for
# local work but only counts per instance on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optional) ----------------------------------------------------
# Each script loads only when its ID is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
