# Signalhaus - environment variables
# Copy this file to .env.local for local development.
# On Vercel, set these under Settings -> Environment Variables.
#
# Nothing here is required. With no variables set, the site builds and runs,
# and each lead form submission leaves one line in the server log and goes
# nowhere else. That line holds a masked email (j***@acme.com), the topic, the
# source form and the post slug. It does not hold the name, the message or the
# full email, so a lead is only kept once one of the adapters below is on.

# --- Lead pipeline ----------------------------------------------------------
# The forms post to /api/leads. The logging sink is always on. Every adapter
# below is a no-op until its variables are set. Feature flags must be exactly
# the string "true" (lower case). Anything else, including "TRUE" or "1", is off.
#
# Once any adapter below is on, the form only reports success when at least one
# of them delivered the lead. If they all fail, the visitor is asked to try
# again in a minute and keeps what they typed.

# Email notification through Resend.
# Sends only when LEAD_RESEND_ENABLED is exactly "true" AND RESEND_API_KEY is set
# AND there is a recipient in LEAD_NOTIFY_TO. Having the API key alone sends nothing.
LEAD_RESEND_ENABLED=false
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where lead notifications are delivered. If this is empty, the older
# CONTACT_EMAIL variable is used when it is set.
LEAD_NOTIFY_TO=
# Optional. The From address. It must be on the verified sending domain
# send.signalhaus.ai. Never use an @signalhaus.ai address here, because the root
# domain's DMARC policy uses strict DKIM alignment. An address on any other
# domain is ignored and the default below is used instead.
LEAD_NOTIFY_FROM="Signalhaus leads <leads@send.signalhaus.ai>"

# Proton inbox copy. Optional second recipient for each lead.
# Proton has no inbound API, so this copy is sent through Resend and needs
# LEAD_RESEND_ENABLED=true and RESEND_API_KEY as well.
LEAD_PROTON_INBOX=

# Lightfield CRM. Finds or creates the account, contact and opportunity, and
# attaches the lead as a note. The opportunity is named
# "Signalhaus · <topic> · <company, or the person's name>". A contact who is
# already in Lightfield, and whose account already has an open opportunity with
# that "Signalhaus · " prefix, gets a note on that one and no second opportunity.
# Runs only when LEAD_LIGHTFIELD_ENABLED is exactly "true" AND LIGHTFIELD_API_KEY is set.
# The key needs these scopes: accounts:read, accounts:create, contacts:read,
# contacts:create, opportunities:read, opportunities:create, notes:create.
LEAD_LIGHTFIELD_ENABLED=false
LIGHTFIELD_API_KEY=
# Optional. The stage a new opportunity starts in. Use the option ID (opt_...)
# of the "Lead" stage in the Signalhaus pipeline. An ID picks the stage and its
# pipeline together. A label ("Lead", exact case) also works, but on its own
# Lightfield looks it up in the default pipeline, so pair a label with
# LIGHTFIELD_PIPELINE_OPTION. Leave empty and the opportunity gets no stage.
LIGHTFIELD_STAGE_LEAD=
# Optional. The pipeline a new opportunity goes in: the pipeline ID (pd_...) or
# its name. Lightfield places a record by its stage and rejects a pipeline sent
# without one, so this is ignored, with a warning in the log, while
# LIGHTFIELD_STAGE_LEAD is empty.
LIGHTFIELD_PIPELINE_OPTION=
# Optional. The key of an opportunity field to write the description to
# (source, page, post slug, topic, UTM values and the visitor's message).
# Opportunities have no description field until one is added in Lightfield,
# so leave this empty until then. The note always carries the same details.
LIGHTFIELD_OPPORTUNITY_DESCRIPTION_FIELD=
# Optional. Set to "true" to let Lightfield enrich new contacts. Enrichment is metered.
LEAD_LIGHTFIELD_ENRICH=false
# Optional overrides. Leave empty to use the defaults.
LIGHTFIELD_API_BASE_URL=
LIGHTFIELD_API_VERSION=

# Slack notification through an incoming webhook.
# Runs only when LEAD_SLACK_ENABLED is exactly "true" AND SLACK_WEBHOOK_URL is set.
LEAD_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

# --- Rate limiting (Upstash Redis) ------------------------------------------
# The lead route allows 5 submissions per IP every 15 minutes.
# With these set, the count is shared across serverless instances.
# Without them, the app falls back to an in-memory limiter that is fine for
# local work but only counts per instance on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optional) ----------------------------------------------------
# Each script loads only when its ID is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
